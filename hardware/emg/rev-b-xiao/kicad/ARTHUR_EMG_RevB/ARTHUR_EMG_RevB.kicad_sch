	(title_block
		(title "A.R.T.H.U.R EMG Rev B - root")
		(date "2026-10-11")
		(rev "B / RB-04A")
		(company "A.R.T.H.U.R EMG")
		(comment 1 "Architecture frozen: RB-00 + RB-00.5 + RB-00.6")
		(comment 2 "RB-04A: BOM fields filled (MPN/LCSC); 2.2 uF 16 V X7R line pending approval; manufacturing BLOCKED")
	)
	(lib_symbols)
	(text "DESIGN INTENT (this sheet):\n- ONE 4-layer EMG PCB + ONE directly mounted Seeed XIAO ESP32S3 (DNP at JLC, hand-soldered) + ONE protected 1S LiPo\n- Architecture frozen RB-00 / RB-00.5 / RB-00.6 (precedence RB-00.6 > RB-00.5 > RB-00). RB-01 = schematic only, no PCB.\n- Removed vs Rev A: MDBT50Q, BQ24074, TPS63031, USB-C/CC/ESD, SWD, Q3002/R3005, charger nets, channel/SPI test points"
		(exclude_from_sim no)
		(at 25.4 256.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "20d8d126-9c50-53b4-9983-adb3bdf36384")
	)
	(text "A.R.T.H.U.R EMG Rev B - RB-01 schematic"
		(exclude_from_sim no)
		(at 25.4 17.78 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left top)
		)
		(uuid "3e741076-ea7a-5ce5-a2c2-5ab4d30ff88f")
	)
	(text "Supplies (power symbols, global): VBAT (J1 star) | AFE_3V0 (TPS7A2030P, gated) | DVDD_F (XIAO 3V3 -> FB1) | GND (single net).\nInter-sheet signals are hierarchical: CHn_P/N, VCM, SPI (SCLK/MOSI/MISO/CS_N), DRDY_N, SYNC_RESET_N, AFE_EN_REQ, XIAO_5V.\nSafety: J5001 pin 1 NC; AFE default OFF (pull-down); USB VBUS hardware inhibit via Q3001; ADC-input clamps after 1k; U503A +IN 10k.\nOperating rule (unchanged from Rev A): no electrodes on the body while USB is connected; no isolation is claimed."
		(exclude_from_sim no)
		(at 25.4 25.4 0)
