  },
  {
    "name": "whitespace only",
    "old": "a b",
    "new": "a  b",
    "expected": {
      "changed": true,
      "segments": [
        {
          "op": "equal",
          "text": "a"
        },
        {
          "op": "delete",
          "text": " "
        },
        {
          "op": "insert",
          "text": "  "
        },
        {
          "op": "equal",
          "text": "b"
        }
      ]
    }
  },
  {
    "name": "repeated words keep a stable choice",
    "old": "a a a",
    "new": "a a",
    "expected": {
      "changed": true,
      "segments": [
        {
          "op": "equal",
          "text": "a a"
