# ------------------------------------------------------------------
# ARTHUR Phase 1 configuration (placeholders only - no real secrets)
# Copy to .env and fill in values. .env is git-ignored.
# ------------------------------------------------------------------

# Runtime environment: development | test | production
ARTHUR_ENV=development

# Local SQLite database path
ARTHUR_DB_PATH=./data/arthur.db

# Model provider: deepseek | fake
# "fake" is the offline default and used by the deterministic test suite.
ARTHUR_MODEL_PROVIDER=deepseek

# Model identifier (configure your DeepSeek V4 Flash identifier here)
ARTHUR_MODEL_NAME=deepseek-chat

# DeepSeek API key (secret - never commit, never log)
DEEPSEEK_API_KEY=

# Optional override of the DeepSeek base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Finite connect/read timeout (seconds)
ARTHUR_MODEL_TIMEOUT_SECONDS=60

# Max number of prior turns included in the model context
ARTHUR_HISTORY_MAX_TURNS=20

# Reasoning profile: fast | normal | deep
ARTHUR_REASONING_PROFILE=normal

# Context token budget (approximate, characters/4)
ARTHUR_CONTEXT_TOKEN_BUDGET=8000

# Retry policy for transient provider failures
ARTHUR_MODEL_RETRY_MAX_ATTEMPTS=3
ARTHUR_MODEL_RETRY_BASE_DELAY_MS=250

# Approval token time-to-live (seconds)
ARTHUR_APPROVAL_TTL_SECONDS=300

# Log level: debug | info | warn | error
ARTHUR_LOG_LEVEL=info

# Bind address and port (localhost only)
ARTHUR_BIND_HOST=127.0.0.1
ARTHUR_BIND_PORT=8080

# ------------------------------------------------------------------
# ARTHUR Phase 2 configuration - isolated Personal/Business memory + local RAG
# ------------------------------------------------------------------

# Two physically separate SQLite stores; the server resolves the domain from
# the session record. Cross-domain access always fails closed.
ARTHUR_MEMORY_PERSONAL_DB_PATH=./data/memory-personal.db
ARTHUR_MEMORY_BUSINESS_DB_PATH=./data/memory-business.db

# Local embedding provider: local_multilingual (default) | fake (offline tests)
ARTHUR_EMBEDDING_PROVIDER=local_multilingual
ARTHUR_EMBEDDING_MODEL=arthur-ngram-v1
ARTHUR_EMBEDDING_DIMENSIONS=384

# Retrieval tuning (hybrid = vector + FTS5 + reciprocal rank fusion + reranker)
ARTHUR_MEMORY_MAX_RETRIEVAL_CANDIDATES=40
ARTHUR_MEMORY_MAX_RERANKED_RESULTS=12
ARTHUR_MEMORY_MAX_CONTEXT_TOKENS=1200
ARTHUR_MEMORY_MAX_SINGLE_CHUNK_TOKENS=300
# Minimum cosine similarity for a vector candidate (0..1)
ARTHUR_MEMORY_VECTOR_MIN_SIMILARITY=0.5

# Post-turn automatic memory extraction (opt-in; extra model call per turn)
ARTHUR_MEMORY_EXTRACTION_ENABLED=false
ARTHUR_MEMORY_EXTRACTION_CONFIDENCE_THRESHOLD=0.6
ARTHUR_MEMORY_EXTRACTION_IMPORTANCE_THRESHOLD=0.2

# TEMPORARY memories expire after this TTL
ARTHUR_MEMORY_TEMPORARY_TTL_SECONDS=86400
# ============================================================================
# Phase 3 - Local voice layer (wake word, VAD, STT, TTS, approvals by voice)
# Disabled by default: ARTHUR stays text-only until ARTHUR_VOICE_ENABLED=true.
# Missing engines NEVER fail startup - voice just reports unavailable and the
# text path is unaffected (fail-closed semantics).
# ============================================================================
# Master switch. false = voice endpoints answer VOICE_DISABLED, no audio IO.
ARTHUR_VOICE_ENABLED=false
# Wake word. local = zero-dependency energy-burst detector (NOT a keyword
# spotter; documented Phase 3 limitation - PTT stays available per DoD).
# fake = deterministic provider for tests/demos.
ARTHUR_WAKE_ENABLED=true
ARTHUR_WAKE_WORD=arthur
ARTHUR_WAKE_PROVIDER=local
# VAD: local = on-device RMS energy detector with hysteresis + debounce.
ARTHUR_VAD_PROVIDER=local
# STT/TTS providers: local = external engine via command (STT_ENGINE_COMMAND /
# TTS_ENGINE_COMMAND), fake = deterministic offline stand-ins.
ARTHUR_STT_PROVIDER=local
ARTHUR_TTS_PROVIDER=local
# STT language profile: en | bg | auto (any whisper.cpp language code is
# accepted by the engine). Prefer an EXPLICIT profile whenever the expected
# language is known: whisper.cpp auto-detection is unstable for short
# accented utterances (real-device A/B: short Bulgarian-accented English was
# detected as Japanese under 'auto'). 'auto' remains the code-level default
# for backwards compatibility; use it only for unknown-language scenarios.
ARTHUR_STT_LANGUAGE=en
# Optional engine hints (local providers). Raw audio is NEVER sent to DeepSeek;
# commands/paths/keys are never exposed through /v1/voice/status.
# Whisper model path (machine-local download; NEVER committed - models/ is
# git-ignored). Recommended primary desktop/server model: large-v3-turbo.
# Example (uncomment and adjust per machine; no real path in committed config):
# ARTHUR_STT_MODEL_PATH=D:\A.R.T.H.U.R\models\ggml-large-v3-turbo.bin
# Lower-resource future nodes may point at a quantized model instead.
ARTHUR_STT_MODEL_PATH=
# Optional whisper.cpp initial prompt (domain vocabulary, max 2048 chars).
# Passed to whisper-cli as one --prompt data argument (never a shell string,
# never logged); empty = disabled. Do not hardcode vocabulary in source.
ARTHUR_STT_INITIAL_PROMPT=ARTHUR, Nexus, AutoPulse, DeepSeek, GitHub, Engineering Mode
ARTHUR_TTS_MODEL_PATH=
ARTHUR_TTS_VOICE=arthur
ARTHUR_AUDIO_INPUT_DEVICE=default
ARTHUR_AUDIO_OUTPUT_DEVICE=default
# Engine commands (local providers only; empty = engine unavailable).
# Commands are TOKENIZED (spaces split args, double quotes group) and spawned
# with child_process.spawn - never exec'd, never a shell. Only trusted startup
# config lands here; STT/TTS text can never alter the command line.
# Contract:
#   capture  -> raw mono s16le PCM on STDOUT (sample rate from settings)
#   playback <- raw mono s16le PCM on STDIN (plays until EOF)
#   STT      <- raw mono s16le PCM on STDIN; exactly one final JSON line on
#               STDOUT: {"text":"...","language":"bg","confidence":0.9}
#   TTS      <- plain speech text on STDIN; raw mono s16le PCM on STDOUT
# Engines that do not match exactly go through tools/voice/*_wrapper.cjs
# (whisper.cpp and piper adapters ship with the repo).
ARTHUR_AUDIO_CAPTURE_COMMAND=
ARTHUR_AUDIO_PLAYBACK_COMMAND=
ARTHUR_STT_ENGINE_COMMAND=
ARTHUR_TTS_ENGINE_COMMAND=

# ----------------------------------------------------------------------------
# Windows v1 reference setup (see README 'Voice - Windows setup'):
#
# 1) Install FFmpeg and add its bin dir to PATH.
#    Capture (list your devices first:  ffmpeg -list_devices true -f dshow -i dummy):
#    ARTHUR_AUDIO_CAPTURE_COMMAND="C:\ffmpeg\bin\ffmpeg.exe -f dshow -i audio=\"Microphone (Realtek(R) Audio)\" -ac 1 -ar 16000 -f s16le pipe:1"
#    Playback (FFplay is bundled with FFmpeg):
#    ARTHUR_AUDIO_PLAYBACK_COMMAND="C:\ffmpeg\bin\ffplay.exe -nodisp -autoexit -f s16le -ar 16000 -ac 1 -"
# 2) whisper.cpp: build/install whisper-cli, download ggml-large-v3-turbo.bin
#    (recommended primary desktop/server model), then:
#    WHISPER_CLI="C:\whisper\build\bin\Release\whisper-cli.exe"
#    WHISPER_MODEL="C:\whisper\models\ggml-large-v3-turbo.bin"
#    ARTHUR_STT_ENGINE_COMMAND="C:\Program Files\nodejs\node.exe \"<repo>\tools\voice\stt_wrapper.cjs\""
# 3) piper: unzip piper binaries + voice, then:
#    PIPER_EXE="C:\piper\piper.exe"
#    PIPER_MODEL="C:\piper\voices\en_US-lessac-medium.onnx"
#    ARTHUR_TTS_ENGINE_COMMAND="C:\Program Files\nodejs\node.exe \"<repo>\tools\voice\tts_wrapper.cjs\""
# 4) ARTHUR_VOICE_ENABLED=true and start the app. Mic -> STT -> DeepSeek ->
#    TTS -> speaker works with no cloud audio service and no raw audio ever
#    leaving the machine.
# ----------------------------------------------------------------------------
# Timing and buffering.
ARTHUR_VAD_END_SILENCE_MS=700
ARTHUR_VOICE_NO_SPEECH_TIMEOUT_MS=6000
ARTHUR_VOICE_MAX_UTTERANCE_MS=30000
ARTHUR_TTS_MAX_QUEUE_CHUNKS=8
ARTHUR_VOICE_MAX_TRANSCRIPT_CHARS=8000
# Privacy: raw audio is never persisted, logged, or transmitted. This flag is
# reserved for future opt-in diagnostics and defaults to false.
ARTHUR_RAW_AUDIO_RETENTION=false
# Reasoning profile used for voice turns.
ARTHUR_VOICE_REASONING_PROFILE=fast
