# ------------------------------------------------------------------
# ARTHUR Phase 1 configuration (placeholders only - no real secrets)
# Copy to .env and fill in values. .env is git-ignored.
# ------------------------------------------------------------------

# Runtime environment: development | test | production
ARTHUR_ENV=development

# Local SQLite database path
ARTHUR_DB_PATH=./data/arthur.db

# Model provider: deepseek | fake
# "fake" is the offline default and used by the deterministic test suite.
ARTHUR_MODEL_PROVIDER=deepseek

# Model identifier (configure your DeepSeek V4 Flash identifier here)
ARTHUR_MODEL_NAME=deepseek-chat

# DeepSeek API key (secret - never commit, never log)
DEEPSEEK_API_KEY=

# Optional override of the DeepSeek base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Finite connect/read timeout (seconds)
ARTHUR_MODEL_TIMEOUT_SECONDS=60

# Max number of prior turns included in the model context
ARTHUR_HISTORY_MAX_TURNS=20

# Reasoning profile: fast | normal | deep
ARTHUR_REASONING_PROFILE=normal

# Context token budget (approximate, characters/4)
ARTHUR_CONTEXT_TOKEN_BUDGET=8000

# Retry policy for transient provider failures
ARTHUR_MODEL_RETRY_MAX_ATTEMPTS=3
ARTHUR_MODEL_RETRY_BASE_DELAY_MS=250

# Approval token time-to-live (seconds)
ARTHUR_APPROVAL_TTL_SECONDS=300

# Log level: debug | info | warn | error
ARTHUR_LOG_LEVEL=info

# Bind address and port (localhost only)
ARTHUR_BIND_HOST=127.0.0.1
ARTHUR_BIND_PORT=8080

# ------------------------------------------------------------------
# ARTHUR Phase 2 configuration - isolated Personal/Business memory + local RAG
# ------------------------------------------------------------------

# Two physically separate SQLite stores; the server resolves the domain from
# the session record. Cross-domain access always fails closed.
ARTHUR_MEMORY_PERSONAL_DB_PATH=./data/memory-personal.db
ARTHUR_MEMORY_BUSINESS_DB_PATH=./data/memory-business.db

# Local embedding provider: local_multilingual (default) | fake (offline tests)
ARTHUR_EMBEDDING_PROVIDER=local_multilingual
ARTHUR_EMBEDDING_MODEL=arthur-ngram-v1
ARTHUR_EMBEDDING_DIMENSIONS=384

# Retrieval tuning (hybrid = vector + FTS5 + reciprocal rank fusion + reranker)
ARTHUR_MEMORY_MAX_RETRIEVAL_CANDIDATES=40
ARTHUR_MEMORY_MAX_RERANKED_RESULTS=12
ARTHUR_MEMORY_MAX_CONTEXT_TOKENS=1200
ARTHUR_MEMORY_MAX_SINGLE_CHUNK_TOKENS=300
# Minimum cosine similarity for a vector candidate (0..1)
ARTHUR_MEMORY_VECTOR_MIN_SIMILARITY=0.5

# Post-turn automatic memory extraction (opt-in; extra model call per turn)
ARTHUR_MEMORY_EXTRACTION_ENABLED=false
ARTHUR_MEMORY_EXTRACTION_CONFIDENCE_THRESHOLD=0.6
ARTHUR_MEMORY_EXTRACTION_IMPORTANCE_THRESHOLD=0.2

# TEMPORARY memories expire after this TTL
ARTHUR_MEMORY_TEMPORARY_TTL_SECONDS=86400
