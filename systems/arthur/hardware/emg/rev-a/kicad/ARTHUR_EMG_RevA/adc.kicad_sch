	(text "Freeze Rev A: ADS1294IPAG 64 pins rechecked vs SBAS459K. IN5-8P/N tied AVDD per unused-pin footnote; CH5-8/RLD/LOFF bits 4-7 unavailable (regs 09h-0Ch). VCAP1 22uF, VCAP2-4 1uF, int 2.4V ref, HR 2kSPS nom (DR=100, BW 524Hz), 4kSPS debug (DR=011)."
		(exclude_from_sim no)
		(at 100 12 0)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "4f55797c-bf8d-5fce-a053-689cc808a280")
	)
	(text "Freeze Rev A: internal 2.048MHz osc (CLKSEL=1, CLK_EN=0); HR mode; START via MCU P0.19 through Ioff buffer U9xx (OE=GND, Audit 1); MISO/DRDY_N direct ADC->MCU."
		(exclude_from_sim no)
		(at 100 255 0)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "987fb58f-c50b-55fd-bc59-b4993ddca83d")
	)
	(text "Firmware dependencies: PD_REFBUF=1, internal 2.4-V reference, RLDREF_INT=1, PD_RLD=1. These are not power-on defaults."
		(exclude_from_sim no)
		(at 100 245 0)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "cfc5f67f-bc41-5802-9958-7414aa26caee")
	)
