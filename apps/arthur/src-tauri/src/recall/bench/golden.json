   "key": "a1",
   "project": "arthur",
   "kind": "idea",
   "title": "Voice-only recorder",
   "body": "Arthur on the phone is a voice-only recorder with no screen to read.",
   "history": [
    {
     "op": "edit",
     "title": "Capture-first mobile",
     "body": "The phone app should open straight into capture, not a feed or a dashboard. Speaking a thought must take one tap."
    }
   ]
  },
  {
   "key": "a2",
   "project": "arthur",
   "kind": "decision",
   "title": "Use temporary audio only during retry",
   "body": "Keep the raw recording on the device only until transcription succeeds or the retry window ends, then delete it.",
   "history": []
  },
  {
   "key": "a3",
   "project": "arthur",
   "kind": "decision",
   "title": "Store knowledge in SQLite",
   "body": "All captures and knowledge objects live in a local SQLite database owned by the user.",
   "history": []
  },
  {
   "key": "a4",
   "project": "arthur",
   "kind": "idea",
   "title": "Offline first",
   "body": "Capture and browsing must keep working without any network connection; only transcription and organizing need the cloud.",
   "history": []
  },
  {
   "key": "a5",
   "project": "arthur",
   "kind": "task",
   "title": "Add Android back button handling",
   "body": "Pressing Back during recording must cancel the recording cleanly.",
   "history": []
  },
  {
   "key": "a6",
   "project": "arthur",
   "kind": "note",
   "title": "Bulgarian speech recognition quality",
