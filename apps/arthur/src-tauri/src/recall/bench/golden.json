   "history": []
  },
  {
   "key": "a8",
   "project": "arthur",
   "kind": "decision",
   "title": "Решение: временно аудио само при повторен опит",
   "body": "Пазим записа само докато транскрипцията успее, после го изтриваме.",
   "history": []
